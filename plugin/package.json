{
  "name": "dsh-center-host",
  "version": "0.2.4",
  "type": "module",
  "description": "将当前 DSH 连接到自己的设备中心，远程使用同一份会话。",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "index.js",
    "tunnel.js",
    "pair.js",
    "cordis.patch.yml",
    "locale",
    "README.md",
    "client.js"
  ],
  "bin": {
    "dsh-center-pair": "./pair.js"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true
    }
  },
  "dependencies": {
    "ws": "8.22.0"
  },
  "engines": {
    "dsh": "0.2.1-rc.3"
  },
  "license": "MIT",
  "author": "Leo / tula-liuxin",
  "repository": {
    "type": "git",
    "directory": "plugin",
    "url": "https://github.com/tula-liuxin/dsh-center.git"
  },
  "homepage": "https://github.com/tula-liuxin/dsh-center#readme"
}
